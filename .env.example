# ==============================================================================
# Hermes Finance Stack — Environment Configuration
# Copy this file to `.env` before running `docker compose up -d`
# ==============================================================================

# --- PostgreSQL (Expenses Database) ---
EXPENSES_DB_USER=expenses_user
EXPENSES_DB_PASSWORD=change_me_strong_password_2026
EXPENSES_DB_NAME=expenses_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- API & Dashboards Ports ---
API_PORT=3000
METABASE_PORT=3005

# --- Hermes Agent Container Permissions ---
HERMES_UID=1000
HERMES_GID=1000

# --- OpenRouter (Free tier models supported via openrouter/free) ---
# Get your key at https://openrouter.ai/keys
# Note: Enable free endpoints in https://openrouter.ai/workspaces/default/guardrails
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# --- Telegram Bot Gateway (Official Hermes Agent) ---
# Create a bot with @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456789:your_telegram_bot_token_here
# Optional: comma-separated numeric Telegram user IDs (e.g. 123456789).
# If left empty, Hermes starts in secure pairing mode and prints/sends a pairing code on your first DM.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# --- Optional: Paperless-ngx Profile (`docker compose --profile paperless up -d`) ---
PAPERLESS_PORT=8010
PAPERLESS_URL=http://localhost:8010
PAPERLESS_SECRET_KEY=change_me_paperless_secret_key_64_chars
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change_me_admin_password
PAPERLESS_OCR_LANGUAGE=spa+eng
# Generate an API token in Paperless UI -> My Profile -> Auth Token (after first boot)
PAPERLESS_API_TOKEN=
